GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Together AI (https://www.together.ai/)
TOGETHER_API_KEY=
