# AI Provider Configuration (Optional)
# If no key is set, the portfolio uses a built-in intelligent human fallback engine.
# Set any of the following keys to enable direct LLM-powered responses:

# Groq API (Recommended: high speed inference at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Together AI (https://www.together.ai/)
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# Web3Forms Contact Form Access Key (https://web3forms.com/)
# In Vercel, you can set WEB3FORMS_ACCESS_KEY as a Secret (Recommended)
# Or set NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY with type Config
WEB3FORMS_ACCESS_KEY=c0135e83-c85d-4c24-a75b-fc100a23e5bb
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=c0135e83-c85d-4c24-a75b-fc100a23e5bb
